#!/usr/bin/env bash
# dsh-hmos — DeepSeek Harness (dsh) 助手脚本(HarmonyOS / harmonybrew 专用)
#
# 用法:
#   dsh-hmos install        安装/修复 dsh 及全部依赖(幂等,可重复执行)
#   dsh-hmos uninstall      卸载 dsh 及脚本状态(保留 ~/.dsh 用户数据)
#   dsh-hmos start [flags]  后台启动 dsh web,flags 原样透传给 dsh web
#                           (如 --port 8080 / --host 0.0.0.0 / --trusted-host ...);
#                           不同 --port 可同时跑多个实例
#   dsh-hmos status         查看所有后台实例运行状态
#   dsh-hmos stop [--port N] 停止指定端口实例;不带参数停止全部
#   dsh-hmos exec <args...> 透传执行 dsh 命令,如: dsh-hmos exec --help
#   dsh-hmos help           显示本帮助
#
# 说明:
# - brew 未安装时 install 会提示访问 https://harmonybrew.atomgit.com 后退出
# - 自动应用 HarmonyOS 必需的三处 patch:
#     1) koffi: 禁用 POST_BUILD strip(hmdfs 的 dlopen 拒绝 stripped .node)
#     2) dsh-session-persistence-jsonl: link -> rename(hmdfs 不支持硬链接)
#     3) dsh-credentials-local: openharmony 平台跳过 0600 权限检查(chmod 无效)
# - 依赖: node ohos-sdk cmake ninja python@3.14(通过 brew 安装)
set -euo pipefail

BREW_PREFIX="$HOME/.harmonybrew"
BREW_BIN="$BREW_PREFIX/bin/brew"
BIN_DIR="$BREW_PREFIX/bin"
NPM_LIB="$BREW_PREFIX/lib/node_modules"
DSH_PKG="$NPM_LIB/@deepseek-ai/dsh"
DSH_BIN="$DSH_PKG/lib/bin.js"
STATE_DIR="$HOME/.dsh-hmos"
TOOLCHAIN_FILE="$STATE_DIR/ohos-aarch64-toolchain.cmake"
REGISTRY="https://registry.npmmirror.com"

log() { echo "[dsh-hmos] $*"; }
die() { echo "[dsh-hmos] 错误: $*" >&2; exit 1; }

# ---------- 基础环境 ----------

ensure_brew() {
    if ! command -v brew >/dev/null 2>&1 && [ ! -x "$BREW_BIN" ]; then
        echo "[dsh-hmos] 未检测到 harmonybrew。"
        echo "[dsh-hmos] 请先按照 https://harmonybrew.atomgit.com 的指引安装 harmonybrew,"
        echo "[dsh-hmos] 然后重新运行: dsh-hmos install"
        exit 1
    fi
    export PATH="$BIN_DIR:$PATH"
}

ensure_installed() {
    [ -x "$DSH_BIN" ] || die "dsh 尚未安装,请先运行: dsh-hmos install"
}

# ---------- install ----------

cmd_install() {
    ensure_brew

    # 1. 系统依赖
    log "检查/安装依赖: node ohos-sdk cmake make ninja python@3.14 ..."
    brew install node ohos-sdk cmake make ninja python@3.14 2>&1 | tail -3 || die "brew install 失败"
    command -v clang >/dev/null 2>&1 || die "ohos-sdk 未提供 clang,请检查安装"
    command -v python3 >/dev/null 2>&1 || die "python3 不可用,请检查 python@3.14 安装"

    # 2. dsh 本体(跳过构建脚本,后续手动构建原生模块)
    if command -v dsh >/dev/null 2>&1; then
        log "dsh 已安装: $(dsh --version 2>/dev/null || echo '?')"
    else
        log "安装 @deepseek-ai/dsh (npm, npmmirror 镜像)..."
        npm install -g @deepseek-ai/dsh --ignore-scripts --registry="$REGISTRY" || die "npm 安装 dsh 失败"
    fi

    # 3. 生成 koffi 构建用 toolchain 文件
    mkdir -p "$STATE_DIR"
    cat > "$TOOLCHAIN_FILE" <<'EOF'
# Force cmake to treat HarmonyOS as Linux/aarch64 (cmake does not know
# HarmonyOS: CMAKE_SYSTEM_PROCESSOR is "unknown", which breaks koffi's
# ABI selection that matches "aarch|arm").
set(CMAKE_SYSTEM_NAME Linux)
execute_process(COMMAND uname -m OUTPUT_VARIABLE HOST_ARCH OUTPUT_STRIP_TRAILING_WHITESPACE)
set(CMAKE_SYSTEM_PROCESSOR ${HOST_ARCH})
EOF

    # 4. 应用 HarmonyOS 必需 patch
    patch_koffi_cmake
    patch_session_persistence
    patch_credentials_local

    # 5. 构建原生模块
    build_node_pty
    build_koffi
    install_sharp_wasm

    log "安装/修复完成。启动: dsh-hmos start"
}

# koffi: 禁用 POST_BUILD strip(hmdfs 的 dlopen 拒绝 stripped .node)
patch_koffi_cmake() {
    local f="$DSH_PKG/node_modules/koffi/src/koffi/CMakeLists.txt"
    [ -f "$f" ] || die "找不到 koffi CMakeLists.txt"
    if grep -q "strip DISABLED for HarmonyOS" "$f"; then
        log "koffi CMakeLists.txt 已 patch,跳过"
        return
    fi
    log "patch koffi CMakeLists.txt (禁用 strip)..."
    python3 - "$f" <<'PYEOF'
import sys
f = sys.argv[1]
src = open(f).read()
marker = 'if(CMAKE_BUILD_TYPE STREQUAL "Release")\n    if(APPLE)'
if marker not in src:
    sys.exit("koffi CMakeLists.txt 结构不符合预期,请手动处理")
start = src.find(marker)
end = src.find('# ---- Debug ----', start)
if end == -1:
    sys.exit("找不到 Debug 段标记")
block = ('if(CMAKE_BUILD_TYPE STREQUAL "Release")\n'
         '    # strip DISABLED for HarmonyOS: stripped .node fails to dlopen\n'
         '    # (Permission denied). Keep the symbol table so the loader accepts it.\n'
         'endif()\n\n')
open(f, 'w').write(src[:start] + block + src[end:])
print("patched")
PYEOF
}

# 会话保存: hmdfs 不支持硬链接, link -> rename
patch_session_persistence() {
    local f="$DSH_PKG/node_modules/@deepseek-ai/dsh-session-persistence-jsonl/lib/index.js"
    [ -f "$f" ] || die "找不到 dsh-session-persistence-jsonl"
    if grep -q "await rename(tmp, finalPath)" "$f"; then
        log "dsh-session-persistence-jsonl 已 patch,跳过"
        return
    fi
    log "patch dsh-session-persistence-jsonl (link -> rename)..."
    python3 - "$f" <<'PYEOF'
import sys
f = sys.argv[1]
src = open(f).read()
old_import = 'import { link, mkdir, mkdtemp, open, readFile, readdir, realpath, rm, stat, truncate } from "node:fs/promises";'
new_import = 'import { rename, mkdir, mkdtemp, open, readFile, readdir, realpath, rm, stat, truncate } from "node:fs/promises";'
old_call = '\t\t\tawait link(tmp, finalPath);'
new_call = '\t\t\tawait rename(tmp, finalPath);'
if old_import not in src or old_call not in src:
    sys.exit("文件结构不符合预期,请手动处理")
open(f, 'w').write(src.replace(old_import, new_import).replace(old_call, new_call))
print("patched")
PYEOF
}

# 凭据检查: hmdfs 固定 660 且 chmod 无效, openharmony 平台跳过
patch_credentials_local() {
    local f="$DSH_PKG/node_modules/@deepseek-ai/dsh-credentials-local/lib/index.js"
    [ -f "$f" ] || die "找不到 dsh-credentials-local"
    if grep -q "openharmony" "$f"; then
        log "dsh-credentials-local 已 patch,跳过"
        return
    fi
    log "patch dsh-credentials-local (跳过 0600 检查)..."
    python3 - "$f" <<'PYEOF'
import sys
f = sys.argv[1]
src = open(f).read()
old = '\tif (process.platform === "win32") return;'
new = '\tif (process.platform === "win32" || process.platform === "openharmony") return; // hmdfs: mode is always 660 and chmod is a no-op'
if old not in src:
    sys.exit("文件结构不符合预期,请手动处理")
open(f, 'w').write(src.replace(old, new, 1))
print("patched")
PYEOF
}

build_node_pty() {
    local out="$DSH_PKG/node_modules/node-pty/build/Release/pty.node"
    [ -f "$out" ] && { log "node-pty 已构建,跳过"; return; }
    command -v make >/dev/null 2>&1 || die "make 不可用(node-gyp 构建 node-pty 需要),请检查 brew install make"
    log "构建 node-pty (node-gyp)..."
    local gyp="$NPM_LIB/npm/node_modules/node-gyp/bin/node-gyp.js"
    [ -f "$gyp" ] || die "找不到 node-gyp"
    ( cd "$DSH_PKG/node_modules/node-pty" && node "$gyp" rebuild ) || die "node-pty 构建失败"
}

build_koffi() {
    local out="$DSH_PKG/node_modules/koffi/build/koffi/openharmony_arm64/koffi.node"
    [ -f "$out" ] && { log "koffi 已构建,跳过"; return; }
    log "构建 koffi (源码, toolchain + 禁用 strip)..."
    export CC="$BIN_DIR/clang" CXX="$BIN_DIR/clang++"
    ( cd "$DSH_PKG/node_modules/koffi" && \
      node ./cnoke.cjs -P . -D src/koffi --release \
        -dCMAKE_TOOLCHAIN_FILE="$TOOLCHAIN_FILE" ) || die "koffi 构建失败"
    [ -f "$out" ] || die "koffi 构建产物缺失"
}

install_sharp_wasm() {
    if [ -d "$DSH_PKG/node_modules/@img/sharp-wasm32" ]; then
        log "sharp-wasm32 已安装,跳过"
        return
    fi
    log "安装 @img/sharp-wasm32 (sharp 的 WebAssembly 后端)..."
    ( cd "$DSH_PKG" && npm install @img/sharp-wasm32 --registry="$REGISTRY" --no-save ) || die "sharp-wasm32 安装失败"
}

# ---------- start / status / stop ----------

# 从参数中提取 --port 值(默认 3080),支持 "--port N" 与 "--port=N" 两种写法
extract_port() {
    local port=3080 prev=""
    for i in "$@"; do
        if [ "$prev" = "--port" ]; then port="$i"; fi
        case "$i" in
            --port=*) port="${i#--port=}";;
        esac
        prev="$i"
    done
    echo "$port"
}

# 判断 PID 是否真的属于 dsh web 进程(防止 PID 复用误判:
# 重启后残留 PID 文件里的 PID 可能已被系统分配给其他进程)
is_dsh_web_pid() {
    local pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "lib/bin\.js web"
}

# 端口是否有服务响应
port_up() {
    node -e "fetch('$1').then(()=>process.exit(0)).catch(()=>process.exit(1))" 2>/dev/null
}

cmd_start() {
    ensure_brew
    ensure_installed
    mkdir -p "$STATE_DIR"

    local port
    port="$(extract_port "$@")"
    local pid_file="$STATE_DIR/web-${port}.pid"
    local log_file="$STATE_DIR/web-${port}.log"
    local url="http://127.0.0.1:${port}/"

    # 1) 端口已有服务 → 已在运行(唯一可靠信号)
    if port_up "$url"; then
        local old_pid=""
        [ -f "$pid_file" ] && old_pid="$(cat "$pid_file" 2>/dev/null || true)"
        log "dsh web (port $port) 已在运行${old_pid:+, PID $old_pid}: $url"
        return 0
    fi

    # 2) PID 文件记录的进程仍活着且确属 dsh web → 可能还在启动中
    local old_pid2=""
    [ -f "$pid_file" ] && old_pid2="$(cat "$pid_file" 2>/dev/null || true)"
    if is_dsh_web_pid "$old_pid2"; then
        log "检测到 dsh web 进程 (PID $old_pid2) 存在但端口 $port 未就绪,可能仍在启动;请稍后用 dsh-hmos status 查看"
        return 1
    fi
    rm -f "$pid_file"

    # 3) 启动
    log "后台启动 dsh web (port $port): dsh web $*"
    export DSH_PERMISSION_MODE="danger-full-access"
    nohup node --expose-internals "$DSH_BIN" web "$@" >>"$log_file" 2>&1 &
    echo $! > "$pid_file"

    # 等待就绪
    for _ in $(seq 1 15); do
        if port_up "$url"; then
            log "dsh web 已启动: $url (PID $(cat "$pid_file"), 日志 $log_file)"
            return 0
        fi
        sleep 1
    done
    log "启动后端口 $port 未就绪,请查看日志: $log_file"
    return 1
}

cmd_status() {
    local running=0
    if [ -d "$STATE_DIR" ]; then
        for pf in "$STATE_DIR"/web-*.pid; do
            [ -f "$pf" ] || continue
            local pid port
            pid="$(cat "$pf" 2>/dev/null || true)"
            port="${pf##*web-}"; port="${port%.pid}"
            if port_up "http://127.0.0.1:${port}/"; then
                log "dsh web (port $port): 运行中${pid:+, PID $pid}, http://127.0.0.1:$port 响应正常"
                running=1
            elif is_dsh_web_pid "$pid"; then
                log "dsh web (port $port): 进程存在 (PID $pid), 但端口 $port 无响应(可能仍在启动或已卡住)"
                running=1
            else
                log "dsh web (port $port): 无运行实例(PID 文件残留已清理)"
                rm -f "$pf"
            fi
        done
    fi
    # 兜底:默认端口有服务但无 PID 记录
    if [ "$running" -eq 0 ]; then
        if port_up "http://127.0.0.1:3080/"; then
            log "dsh web: 端口 3080 有服务响应,但无 PID 记录(可能是其他方式启动的)"
        else
            log "dsh web: 未运行"
        fi
        return 1
    fi
    return 0
}

cmd_stop() {
    # 支持 --port N 只停止指定实例;不带参数停止全部
    local only_port="" prev=""
    for i in "$@"; do
        if [ "$prev" = "--port" ]; then only_port="$i"; fi
        case "$i" in
            --port=*) only_port="${i#--port=}";;
        esac
        prev="$i"
    done

    local stopped=0
    if [ -d "$STATE_DIR" ]; then
        for pf in "$STATE_DIR"/web-*.pid; do
            [ -f "$pf" ] || continue
            local pid port
            port="${pf##*web-}"; port="${port%.pid}"
            if [ -n "$only_port" ] && [ "$port" != "$only_port" ]; then continue; fi
            pid="$(cat "$pf" 2>/dev/null || true)"
            # 仅 kill 确属 dsh web 的进程,防止 PID 复用误杀
            if is_dsh_web_pid "$pid"; then
                kill "$pid" 2>/dev/null || true
                log "已发送停止信号 (port $port, PID $pid)"
                stopped=1
            fi
            rm -f "$pf"
        done
    fi
    # 兜底:清理残留的 dsh web 进程(仅未指定端口时)
    if [ -z "$only_port" ]; then
        local leftovers
        leftovers="$(ps -ef 2>/dev/null | grep -E "lib/bin\.js web" | grep -v grep | awk '{print $2}' || true)"
        if [ -n "$leftovers" ]; then
            # shellcheck disable=SC2086
            kill $leftovers 2>/dev/null || true
            log "已清理残留进程: $leftovers"
            stopped=1
        fi
    fi
    if [ "$stopped" -eq 1 ]; then
        log "dsh web 已停止"
    else
        log "dsh web 未在运行"
    fi
}

# ---------- exec ----------

cmd_exec() {
    ensure_brew
    ensure_installed
    export DSH_PERMISSION_MODE="${DSH_PERMISSION_MODE:-danger-full-access}"
    node --expose-internals "$DSH_BIN" "$@"
}

# ---------- uninstall ----------

cmd_uninstall() {
    ensure_brew
    # 先停掉正在运行的服务
    cmd_stop 2>/dev/null || true
    if command -v dsh >/dev/null 2>&1; then
        log "卸载 @deepseek-ai/dsh (npm)..."
        npm uninstall -g @deepseek-ai/dsh 2>&1 | tail -3 || die "npm uninstall 失败"
        log "dsh 已卸载"
    else
        log "dsh 未安装,跳过 npm 卸载"
    fi
    # 清理脚本自身状态(pid/log/toolchain),保留 ~/.dsh 用户数据
    if [ -d "$STATE_DIR" ]; then
        rm -rf "$STATE_DIR"
        log "已清理脚本状态目录: $STATE_DIR"
    fi
    log "卸载完成。~/.dsh(会话/凭据/配置)已保留;如需彻底清除请手动删除 ~/.dsh"
}

# ---------- main ----------

usage() {
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-help}" in
    install) shift; cmd_install "$@";;
    uninstall) shift; cmd_uninstall "$@";;
    start)   shift; cmd_start "$@";;
    status)  cmd_status "$@";;
    stop)    shift; cmd_stop "$@";;
    exec)    shift; cmd_exec "$@";;
    help|-h|--help) usage;;
    *) echo "未知命令: ${1:-}"; usage; exit 1;;
esac
